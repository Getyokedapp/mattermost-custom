# Copy to /srv/mattermost/.env and fill in the two marked values (mode 600).
# This file is the only place host configuration is stored; the real .env never
# gets committed.

# --- public address ---------------------------------------------------------
MM_SERVICESETTINGS_SITEURL=https://mm.internal.getyokedapp.com
MM_TEAMSETTINGS_SITENAME=Yoked

# --- database (PlanetScale Postgres) ---------------------------------------
# postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE=postgres://REPLACE_ME:REPLACE_ME@REPLACE_ME:5432/mattermost?sslmode=require

# --- sign-in policy: Cloudflare Access in front, so no local passwords -----
MM_SERVICESETTINGS_ENABLESIGNUPWITHEMAIL=false
MM_SERVICESETTINGS_ENABLESIGNINWITHEMAIL=true
MM_EMAILSETTINGS_REQUIREEMAILVERIFICATION=false

# --- server behaviour ------------------------------------------------------
MM_SERVICEENVIRONMENT=production
MM_LOGSETTINGS_CONSOLELEVEL=INFO
MM_FILESETTINGS_DIRECTORY=/mattermost/data
MM_PLUGINSETTINGS_ENABLEUPLOADS=true
MM_SERVICESETTINGS_ENABLEBOTACCOUNTCREATION=true
MM_SERVICESETTINGS_ENABLEUSERACCESSTOKENS=true
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=false

# mmctl --local talks to the server over its unix socket.
MM_SERVICESETTINGS_ENABLELOCALMODE=true

# The Hermes gateway runs on the host and is reached from the container's network;
# only this address is allowed to be called without goaway/allow-internal checks.
MM_SERVICESETTINGS_ALLOWEDUNTRUSTEDINTERNALCONNECTIONS=172.19.0.1

# Rewritten by pull-edge.sh. Pin a tag here to hold a specific build.
MM_IMAGE=ghcr.io/getyokedapp/mattermost-custom:edge

# --- OIDC (uncomment once the Cloudflare Access application exists) --------
# MM_OPENIDSETTINGS_ENABLE=true
# MM_OPENIDSETTINGS_DISCOVERYENDPOINT=https://<your-team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<id>/.well-known/openid-configuration
# MM_OPENIDSETTINGS_CLIENTID=
# MM_OPENIDSETTINGS_CLIENTSECRET=
# MM_OPENIDSETTINGS_IDCLAIM=email
# MM_OPENIDSETTINGS_BUTTONTEXT=Cloudflare Access
