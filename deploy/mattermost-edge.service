[Unit]
Description=Deploy the published Mattermost edge image when it changes
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/mattermost/deploy
ExecStart=/srv/mattermost/deploy/pull-edge.sh
TimeoutStartSec=20min
Restart=no
